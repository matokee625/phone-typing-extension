# Safaricom Daraja API Credentials for Quickmart Supermarket Live STK Push
# Obtain these from: https://developer.safaricom.co.ke/

# MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/quickmart?retryWrites=true&w=majority
MONGODB_URI=

# Set to "production" for live Quickmart Till / Paybill, or "sandbox" for testing
DARAJA_ENV=sandbox

# Daraja App Consumer Key & Consumer Secret
DARAJA_CONSUMER_KEY=your_daraja_consumer_key_here
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret_here

# Business Shortcode (Paybill or Till Number, default sandbox is 174379)
DARAJA_BUSINESS_SHORTCODE=174379

# Daraja Online Passkey (from Safaricom Daraja portal)
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919


